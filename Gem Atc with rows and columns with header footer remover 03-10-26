class _PreviewSourceMarker(Flowable):
    """Zero-size marker used to map editor content to the actual PDF page."""
    def __init__(self, source):
        super().__init__()
        self.source = dict(source)
        self.width = 0
        self.height = 0

    def wrap(self, availWidth, availHeight):
        return 0, 0

    def draw(self):
        pass


class _SourceParagraph(Paragraph):
    """Paragraph that carries its editor source through pagination/splitting."""
    def __init__(self, text, style, source=None, **kwargs):
        super().__init__(text, style, **kwargs)
        self._preview_source = dict(source or {})

    def split(self, availWidth, availHeight):
        parts = super().split(availWidth, availHeight)
        for part in parts:
            part._preview_source = dict(self._preview_source)
        return parts


class _SourceTrackingDocTemplate(BaseDocTemplate):
    """Collect source markers using ReportLab's real page layout."""
    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.page_sources = {}

    def afterFlowable(self, flowable):
        source = None
        if isinstance(flowable, _PreviewSourceMarker):
            source = flowable.source
        else:
            source = getattr(flowable, "_preview_source", None)

        if source:
            sources = self.page_sources.setdefault(self.page, [])
            source = dict(source)
            if source not in sources:
                sources.append(source)


