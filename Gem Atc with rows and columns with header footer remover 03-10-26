    def _reupload_source_info(self, entry):
        """Return human-readable source information without changing stored records."""
        line = entry.get("line")
        for rec in self.docs_images:
            if len(rec) >= 4 and rec[0] == "img" and rec[2] == line:
                return {"label": "Add Docs / Submit Docs", "detail": "Inserted document/image page"}
        for rec in self.pdf_images:
            if len(rec) >= 7 and rec[0] == "img" and rec[2] == line:
                slide_id = rec[6]
                source = self.pdf_slide_source.get(slide_id)
                if source:
                    path, page_no = source
                    return {
                        "label": "PDF Paster",
                        "detail": f"PDF: {os.path.basename(path)}  |  Slide: {page_no}"
                    }
                return {"label": "PDF Paster", "detail": "Pasted PDF/JPG page"}
        return {"label": "Pasted Image", "detail": "Image inserted in Terms & Conditions"}

    def _remove_reupload_target_records(self, entry):
        """Remove only the selected image's bookkeeping; text content stays intact."""
        oldline = entry["line"]
        oldimg = entry.get("img")
        old_slide_ids = []
        for rec in self.pdf_images:
            if len(rec) >= 7 and rec[0] == "img" and rec[2] == oldline:
                old_slide_ids.append(rec[6])
        self._delete_editor_line_image_only(oldline)
        self.tracked_images = [r for r in self.tracked_images if r[0] != oldline]
        self.pdf_images = [r for r in self.pdf_images if r[2] != oldline]
        self.docs_images = [r for r in self.docs_images if r[2] != oldline]
        self.image_archive = [e for e in self.image_archive if e is not entry and e.get("line") != oldline]
        for sid in old_slide_ids:
            self.pdf_slide_source.pop(sid, None)
        return oldline, oldimg

    def run_reupload_flow(self):
        """Visual, safe re-upload flow. Existing replacement backend behavior is preserved."""
        if not self.image_archive:
            messagebox.showinfo("Archive", "No pages/images saved in archive.")
            return

        # Snapshot the archive so selecting/searching in the dialog never mutates it.
        entries = [dict(e) for e in self.image_archive if e.get("img") is not None]
        dlg = ReuploadPageSelector(self, entries, self._reupload_source_info)
        self.wait_window(dlg)
        entry = dlg.result
        if not entry:
            return

        oldline = entry["line"]
        oldw, oldh = entry.get("width", entry["img"].size[0]), entry.get("height", entry["img"].size[1])
        old_pdf = any(r[0] == "img" and r[2] == oldline for r in self.pdf_images)
        old_docs = any(r[0] == "img" and r[2] == oldline for r in self.docs_images)

        path = filedialog.askopenfilename(
            title=f"Select replacement for selected page (line {oldline})",
            filetypes=[
                ("Images or PDF", "*.jpg *.jpeg *.png *.pdf"),
                ("Image Files", "*.jpg *.jpeg *.png"),
                ("PDF Files", "*.pdf"),
                ("All Files", "*.*"),
            ]
        )
        # IMPORTANT: do not remove the old page until the replacement has been
        # successfully selected and prepared.
        if not path:
            self.status_text.set("Reupload cancelled. Original page is unchanged.")
            return

        ext = os.path.splitext(path)[1].lower()
        replacement_img = None
        replacement_pdf_page = None

        try:
            if ext == ".pdf":
                pdfdlg = ReuploadPDFPageSelector(self, path)
                self.wait_window(pdfdlg)
                if not pdfdlg.result:
                    self.status_text.set("PDF slide selection cancelled. Original page is unchanged.")
                    return
                replacement_pdf_page, replacement_img = pdfdlg.result
            else:
                replacement_img = Image.open(path).convert("RGB")

            if replacement_img is None:
                raise ValueError("Replacement image could not be loaded.")

            replacement_img = replacement_img.resize((oldw, oldh), Image.LANCZOS)

            # Confirmation is shown after the exact new image/slide is known.
            confirm = messagebox.askyesno(
                "Confirm Page Replacement",
                f"Replace editor line {oldline}?\n\n"
                f"Old page: selected visual page\n"
                f"New file: {os.path.basename(path)}"
                + (f"\nNew PDF slide: {replacement_pdf_page}" if replacement_pdf_page else "")
                + "\n\nThe old page will be replaced at the same location.",
                parent=self
            )
            if not confirm:
                self.status_text.set("Replacement cancelled. Original page is unchanged.")
                return

            # Only now remove the old visual page and insert the replacement.
            self._remove_reupload_target_records(entry)
            self._pending_pdf_source = None

            if replacement_pdf_page is not None:
                pdf_slide_id = f"pdfslide-reupload-{replacement_pdf_page}-{id(replacement_img)}"
                self._pending_pdf_source = (self._source_file_key(path), replacement_pdf_page)
                newline = self.insert_image_on_newline(
                    replacement_img, "center", aroundline=oldline,
                    ispdf=True, isdocs=old_docs, pdf_slide_id=pdf_slide_id
                )
                self._pending_pdf_source = None
                self.status_text.set(
                    f"Page reuploaded successfully: PDF slide {replacement_pdf_page} -> editor line {newline}."
                )
            else:
                newline = self.insert_image_on_newline(
                    replacement_img, "center", aroundline=oldline,
                    ispdf=old_pdf, isdocs=old_docs
                )
                self.status_text.set(
                    f"Image reuploaded successfully -> editor line {newline}."
                )

            self.on_editor_change()

        except Exception as exc:
            self._pending_pdf_source = None
            messagebox.showerror(
                "Reupload Error",
                f"Replacement could not be completed.\n\n{exc}\n\n"
                "The original page was kept if replacement had not started.",
                parent=self
            )

