class EditableTableFrame(tk.Frame):
    """An Excel/Word-like editable table embedded inside the T&C Text widget.

    Every cell is a real Entry widget, so the user can type directly into it.
    Normal Tk clipboard operations (Ctrl+C/Ctrl+V/Ctrl+X/Ctrl+A) work in each
    cell.  Ctrl+V also understands tab/newline separated clipboard data and
    distributes it across the table starting at the active cell, similar to
    Excel.
    """
    def __init__(self, parent, rows, cols, on_change=None):
        super().__init__(parent, bg="#4b5563", bd=1, relief="solid")
        self.rows = int(rows)
        self.cols = int(cols)
        self.on_change = on_change
        self.entries = []
        self.active_cell = (0, 0)

        # Keep the table compact enough for the T&C editor while still being
        # comfortable to edit.
        try:
            available = max(720, int(parent.winfo_width() * 0.92))
        except Exception:
            available = 900
        cell_width_px = max(75, min(150, int(available / max(1, self.cols))))
        cell_width_chars = max(8, min(18, int(cell_width_px / 8)))

        for r in range(self.rows):
            row_entries = []
            for c in range(self.cols):
                bg = "#eef2f7" if r == 0 else "#ffffff"
                e = tk.Entry(
                    self, width=cell_width_chars,
                    font=("Arial", 10),
                    bg=bg, fg="#111827",
                    insertbackground="#111827",
                    relief="flat", bd=0,
                    highlightthickness=1,
                    highlightbackground="#9ca3af",
                    highlightcolor="#2563eb",
                    state="normal",
                    takefocus=1
                )
                e.grid(row=r, column=c, sticky="nsew", padx=1, pady=1, ipady=6)

                # IMPORTANT: these are real Entry widgets. Explicitly take focus
                # on mouse click so the parent ScrolledText cannot keep the focus
                # after a table is inserted. This makes direct cell typing reliable.
                e.bind("<Button-1>", lambda ev, rr=r, cc=c: self._click_cell(ev, rr, cc))
                e.bind("<FocusIn>", lambda _ev, rr=r, cc=c: self._focus_cell(rr, cc))
                e.bind("<KeyRelease>", self._changed)
                e.bind("<Control-v>", lambda ev, rr=r, cc=c: self._paste_matrix(ev, rr, cc))
                e.bind("<Control-V>", lambda ev, rr=r, cc=c: self._paste_matrix(ev, rr, cc))
                e.bind("<Control-c>", lambda ev: self._copy_cell(ev))
                e.bind("<Control-C>", lambda ev: self._copy_cell(ev))
                e.bind("<Control-x>", lambda ev: self._cut_cell(ev))
                e.bind("<Control-X>", lambda ev: self._cut_cell(ev))
                e.bind("<Control-a>", lambda ev: self._select_all_cell(ev))
                e.bind("<Control-A>", lambda ev: self._select_all_cell(ev))
                e.bind("<Tab>", lambda ev, rr=r, cc=c: self._move_cell(ev, rr, cc, 0, 1))
                e.bind("<Return>", lambda ev, rr=r, cc=c: self._move_cell(ev, rr, cc, 1, 0))
                row_entries.append(e)
            self.entries.append(row_entries)

        for c in range(self.cols):
            self.grid_columnconfigure(c, weight=1, uniform="tc_table_col")
        for r in range(self.rows):
            self.grid_rowconfigure(r, weight=1)

    def _click_cell(self, event, r, c):
        entry = self.entries[r][c]
        self.active_cell = (r, c)
        try:
            entry.focus_set()
            # Put the insertion point exactly where the user clicked.
            index = entry.index(f"@{event.x}")
            entry.icursor(index)
        except Exception:
            entry.focus_force()
        return "break"

    def _focus_cell(self, r, c):
        self.active_cell = (r, c)

    def _select_all_cell(self, event):
        event.widget.selection_range(0, tk.END)
        return "break"

    def _copy_cell(self, event):
        try:
            event.widget.event_generate("<<Copy>>")
        except Exception:
            pass
        return "break"

    def _cut_cell(self, event):
        try:
            event.widget.event_generate("<<Cut>>")
        except Exception:
            pass
        self._changed()
        return "break"

    def _move_cell(self, event, r, c, dr, dc):
        nr, nc = r + dr, c + dc
        if nr >= self.rows:
            nr, nc = 0, min(c + 1, self.cols - 1)
        elif nc >= self.cols:
            nr, nc = r + 1, 0
            if nr >= self.rows:
                nr = 0
        self.active_cell = (nr, nc)
        self.entries[nr][nc].focus_set()
        self.entries[nr][nc].selection_range(0, tk.END)
        return "break"

    def _changed(self, _event=None):
        if callable(self.on_change):
            self.on_change()

    def _paste_matrix(self, event, start_r, start_c):
        try:
            value = self.clipboard_get()
        except Exception:
            return "break"

        # Excel-style clipboard data: rows separated by newline and cells by tab.
        rows = value.replace("\r\n", "\n").replace("\r", "\n").split("\n")
        matrix = [row.split("\t") for row in rows]
        # A normal single-cell paste should behave exactly like Entry paste.
        if len(matrix) == 1 and len(matrix[0]) == 1:
            entry = self.entries[start_r][start_c]
            try:
                entry.delete("sel.first", "sel.last")
            except Exception:
                pass
            entry.insert(tk.INSERT, matrix[0][0])
            self._changed()
            return "break"

        for rr, values in enumerate(matrix):
            tr = start_r + rr
            if tr >= self.rows:
                break
            for cc, value in enumerate(values):
                tc = start_c + cc
                if tc >= self.cols:
                    break
                self.entries[tr][tc].delete(0, tk.END)
                self.entries[tr][tc].insert(0, value)
        self._changed()
        return "break"

    def set_data(self, data):
        for r in range(self.rows):
            for c in range(self.cols):
                value = data[r][c] if r < len(data) and c < len(data[r]) else ""
                self.entries[r][c].delete(0, tk.END)
                self.entries[r][c].insert(0, value)
        self._changed()

    def get_data(self):
        return [[entry.get() for entry in row] for row in self.entries]


class TableDataEditorDialog(tk.Toplevel):
    """Popup editor for an embedded table. Supports typing, normal clipboard
    operations and Excel-style multi-cell paste (tabs + new lines)."""
    def __init__(self, parent, table_widget):
        super().__init__(parent)
        self.title("Edit Table Data")
        self.configure(bg="#23242e")
        self.geometry("900x600")
        self.minsize(650, 420)
        self.transient(parent)
        self.grab_set()
        self.table_widget = table_widget
        self.result = None
        self.rows = table_widget.rows
        self.cols = table_widget.cols
        self.data = table_widget.get_data()
        self.entries = []
        self.active_cell = [0, 0]

        top = tk.Frame(self, bg="#23242e")
        top.pack(fill="x", padx=14, pady=(12, 8))
        tk.Label(top, text="Edit Table Data", bg="#23242e", fg="white",
                 font=("Arial", 15, "bold")).pack(anchor="w")
        tk.Label(top,
                 text="Type in any cell. Ctrl+C / Ctrl+V works. Copy data from Excel and paste it into the selected cell to fill multiple cells.",
                 bg="#23242e", fg="#cbd5e1", font=("Arial", 9), wraplength=840,
                 justify="left").pack(anchor="w", pady=(3, 0))

        outer = tk.Frame(self, bg="#9ca3af", bd=1, relief="solid")
        outer.pack(fill="both", expand=True, padx=14, pady=5)
        canvas = tk.Canvas(outer, bg="#f8fafc", highlightthickness=0)
        sy = ttk.Scrollbar(outer, orient="vertical", command=canvas.yview)
        sx = ttk.Scrollbar(outer, orient="horizontal", command=canvas.xview)
        grid = tk.Frame(canvas, bg="#f8fafc")
        canvas.create_window((0, 0), window=grid, anchor="nw")
        canvas.configure(yscrollcommand=sy.set, xscrollcommand=sx.set)
        canvas.pack(side="left", fill="both", expand=True)
        sy.pack(side="right", fill="y")
        sx.pack(side="bottom", fill="x")

        for c in range(self.cols):
            tk.Label(grid, text=f"Column {c + 1}", bg="#dbeafe", fg="#111827",
                     font=("Arial", 9, "bold"), width=16, relief="solid", bd=1,
                     pady=5).grid(row=0, column=c, sticky="nsew")

        for r in range(self.rows):
            row = []
            for c in range(self.cols):
                e = tk.Entry(grid, bg="white", fg="#111827", insertbackground="#111827",
                             font=("Arial", 10), relief="solid", bd=1, width=18)
                value = self.data[r][c] if r < len(self.data) and c < len(self.data[r]) else ""
                e.insert(0, value)
                e.grid(row=r + 1, column=c, sticky="nsew", ipady=7)
                e.bind("<FocusIn>", lambda ev, rr=r, cc=c: self._select(rr, cc))
                e.bind("<Button-1>", lambda ev, rr=r, cc=c: self._select(rr, cc))
                e.bind("<Control-v>", self._paste_matrix)
                e.bind("<Control-V>", self._paste_matrix)
                e.bind("<Tab>", lambda ev, rr=r, cc=c: self._move(rr, cc, 0, 1))
                e.bind("<Return>", lambda ev, rr=r, cc=c: self._move(rr, cc, 1, 0))
                row.append(e)
            self.entries.append(row)

        grid.update_idletasks()
        canvas.configure(scrollregion=canvas.bbox("all"))

        buttons = tk.Frame(self, bg="#23242e")
        buttons.pack(fill="x", padx=14, pady=(8, 14))
        tk.Button(buttons, text="Save Table", command=self._save, bg="#107d4e", fg="white",
                  font=("Arial", 10, "bold"), padx=18, pady=6, bd=0).pack(side="left")
        tk.Button(buttons, text="Cancel", command=self.destroy, bg="#c0342c", fg="white",
                  font=("Arial", 10, "bold"), padx=18, pady=6, bd=0).pack(side="right")
        self.protocol("WM_DELETE_WINDOW", self.destroy)
        if self.entries and self.entries[0]:
            self.entries[0][0].focus_set()

    def _select(self, r, c):
        self.active_cell = [r, c]

    def _move(self, r, c, dr, dc):
        nr, nc = r + dr, c + dc
        if nr >= self.rows:
            nr, nc = 0, min(c + 1, self.cols - 1)
        elif nc >= self.cols:
            nr, nc = r + 1, 0
            if nr >= self.rows:
                nr = 0
        self.active_cell = [nr, nc]
        self.entries[nr][nc].focus_set()
        return "break"

    def _paste_matrix(self, event=None):
        try:
            value = self.clipboard_get()
        except Exception:
            return "break"
        r0, c0 = self.active_cell
        matrix = value.replace("\r\n", "\n").replace("\r", "\n").split("\n")
        if matrix and matrix[-1] == "":
            matrix.pop()
        for rr, line in enumerate(matrix):
            r = r0 + rr
            if r >= self.rows:
                break
            values = line.split("\t")
            for cc, cell_value in enumerate(values):
                c = c0 + cc
                if c >= self.cols:
                    break
                e = self.entries[r][c]
                e.delete(0, tk.END)
                e.insert(0, cell_value)
        return "break"

    def _save(self):
        data = [[e.get() for e in row] for row in self.entries]
        self.table_widget.set_data(data)
        self.result = data
        self.destroy()


