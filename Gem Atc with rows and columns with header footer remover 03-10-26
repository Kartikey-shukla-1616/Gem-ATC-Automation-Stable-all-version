    def insert_pdf_file_as_images_at_cursor(self, pdfpath):
        try:
            with pdfplumber.open(pdfpath) as pdf:
                insert_after = None
                for pdf_page_number, page in enumerate(pdf.pages, start=1):
                    imgpage = page.to_image(resolution=400).original.convert("RGB")
                    if imgpage.width > 1000:
                        imgpage = imgpage.resize((1000, int(imgpage.height * 1000 / imgpage.width)), Image.LANCZOS)
                    pdf_slide_id = f"pdfslide-doc-{pdf_page_number}-{id(imgpage)}"
                    self._pending_pdf_source = (self._source_file_key(pdfpath), pdf_page_number)
                    if insert_after is None:
                        insert_after = self.insert_image_inline(
                            imgpage, "center", isdocs=True, ispdf=True, pdf_slide_id=pdf_slide_id
                        )
                    else:
                        insert_after = self.insert_image_on_newline(
                            imgpage, "center", aroundline=insert_after, isdocs=True, ispdf=True,
                            pdf_slide_id=pdf_slide_id
                        )
                    self._pending_pdf_source = None
        except Exception as e:
            messagebox.showerror("Error", f"Failed to convert Doc PDF pages to images:\n{e}")

