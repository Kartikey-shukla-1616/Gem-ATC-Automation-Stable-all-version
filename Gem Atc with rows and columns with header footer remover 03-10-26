class ReuploadPageSelector(tk.Toplevel):
    """Visual selector for an existing pasted page/image.

    This is intentionally isolated to the re-upload workflow. It does not
    change the underlying image archive or editor records until the user
    confirms a replacement.
    """
    def __init__(self, parent, entries, source_getter):
        super().__init__(parent)
        self.parent = parent
        self.entries = list(entries)
        self.source_getter = source_getter
        self.result = None
        self.thumb_refs = []
        self.preview_ref = None
        self.selected_index = None

        self.title("Reupload Page - Select Exact Page")
        self.geometry("1120x720")
        self.minsize(900, 600)
        self.configure(bg="#23242e")

        header = tk.Frame(self, bg="#23242e")
        header.pack(fill="x", padx=12, pady=(10, 5))
        tk.Label(
            header, text="Select the exact page you want to re-upload",
            bg="#23242e", fg="white", font=("Arial", 13, "bold")
        ).pack(side="left")
        tk.Label(
            header, text="Click a thumbnail to see a large preview",
            bg="#23242e", fg="#b8bcc8", font=("Arial", 9)
        ).pack(side="left", padx=15)

        search_frame = tk.Frame(self, bg="#23242e")
        search_frame.pack(fill="x", padx=12, pady=(0, 8))
        tk.Label(search_frame, text="Search:", bg="#23242e", fg="white").pack(side="left")
        self.search_var = tk.StringVar()
        search = tk.Entry(search_frame, textvariable=self.search_var, width=38)
        search.pack(side="left", padx=7)
        search.bind("<KeyRelease>", lambda e: self._rebuild_cards())
        tk.Button(
            search_frame, text="Clear", command=lambda: self.search_var.set("") or self._rebuild_cards(),
            bg="#4b5563", fg="white"
        ).pack(side="left")

        body = tk.Frame(self, bg="#23242e")
        body.pack(fill="both", expand=True, padx=12, pady=5)

        # Left: scrollable thumbnail grid.
        left = tk.Frame(body, bg="#1d1e27", bd=1, relief="solid")
        left.pack(side="left", fill="both", expand=True, padx=(0, 8))
        self.canvas = tk.Canvas(left, bg="#1d1e27", highlightthickness=0)
        self.scrollbar = tk.Scrollbar(left, orient="vertical", command=self.canvas.yview)
        self.canvas.configure(yscrollcommand=self.scrollbar.set)
        self.scrollbar.pack(side="right", fill="y")
        self.canvas.pack(side="left", fill="both", expand=True)
        self.grid_frame = tk.Frame(self.canvas, bg="#1d1e27")
        self.canvas_window = self.canvas.create_window((0, 0), window=self.grid_frame, anchor="nw")
        self.grid_frame.bind("<Configure>", lambda e: self.canvas.configure(scrollregion=self.canvas.bbox("all")))
        self.canvas.bind("<Configure>", self._resize_inner)
        self.canvas.bind_all("<MouseWheel>", self._mousewheel, add="+")

        # Right: large preview.
        right = tk.Frame(body, bg="#1d1e27", bd=1, relief="solid", width=390)
        right.pack(side="right", fill="y")
        right.pack_propagate(False)
        tk.Label(right, text="Selected Page Preview", bg="#1d1e27", fg="white", font=("Arial", 11, "bold")).pack(pady=(12, 6))
        self.preview_label = tk.Label(right, bg="#111218", fg="#9ca3af", text="Select a page")
        self.preview_label.pack(fill="both", expand=True, padx=12, pady=8)
        self.info_var = tk.StringVar(value="No page selected")
        tk.Label(right, textvariable=self.info_var, justify="left", anchor="w", wraplength=350,
                 bg="#1d1e27", fg="#d8dbe3", font=("Arial", 9)).pack(fill="x", padx=12, pady=8)

        btns = tk.Frame(self, bg="#23242e")
        btns.pack(fill="x", padx=12, pady=(5, 12))
        tk.Button(btns, text="Select This Page", command=self.on_select, bg="#006bce", fg="white", width=18).pack(side="left", padx=5)
        tk.Button(btns, text="Cancel", command=self.on_cancel, bg="#c0342c", fg="white", width=12).pack(side="right", padx=5)

        self._rebuild_cards()
        self.transient(parent)
        self.grab_set()
        self.focus_force()

    def _resize_inner(self, event):
        try:
            self.canvas.itemconfigure(self.canvas_window, width=max(event.width - 4, 1))
        except Exception:
            pass

    def _mousewheel(self, event):
        try:
            if self.winfo_exists():
                self.canvas.yview_scroll(int(-1 * (event.delta / 120)), "units")
        except Exception:
            pass

    def _filtered(self):
        q = self.search_var.get().strip().lower()
        if not q:
            return list(enumerate(self.entries))
        out = []
        for idx, entry in enumerate(self.entries):
            source = self.source_getter(entry)
            hay = " ".join([
                str(idx + 1), str(entry.get("line", "")),
                str(entry.get("title", "")), str(source.get("label", "")),
                str(source.get("detail", ""))
            ]).lower()
            if q in hay:
                out.append((idx, entry))
        return out

    def _make_thumb(self, img, max_w=145, max_h=145):
        thumb = img.copy()
        thumb.thumbnail((max_w, max_h), Image.LANCZOS)
        return ImageTk.PhotoImage(thumb)

    def _rebuild_cards(self):
        for child in self.grid_frame.winfo_children():
            child.destroy()
        self.thumb_refs = []
        filtered = self._filtered()
        if not filtered:
            tk.Label(self.grid_frame, text="No matching pages", bg="#1d1e27", fg="#cbd5e1",
                     font=("Arial", 11)).grid(row=0, column=0, padx=30, pady=30)
            return

        columns = 3
        for pos, (idx, entry) in enumerate(filtered):
            card = tk.Frame(self.grid_frame, bg="#292b36", bd=1, relief="solid", cursor="hand2")
            row, col = divmod(pos, columns)
            card.grid(row=row, column=col, padx=8, pady=8, sticky="nsew")
            img = entry.get("img")
            if img is not None:
                ph = self._make_thumb(img)
                self.thumb_refs.append(ph)
                lbl = tk.Label(card, image=ph, bg="#111218")
                lbl.pack(padx=8, pady=8)
            source = self.source_getter(entry)
            title = entry.get("title") or "(no nearby text)"
            if len(title) > 34:
                title = title[:34] + "..."
            text = f"Page {idx + 1}  |  Line {entry.get('line')}\n{source.get('label', 'Image')}\n{title}"
            info = tk.Label(card, text=text, bg="#292b36", fg="white", justify="left", wraplength=175,
                            font=("Arial", 8, "bold"))
            info.pack(fill="x", padx=8, pady=(0, 8))
            for widget in (card, lbl, info):
                widget.bind("<Button-1>", lambda e, i=idx: self._select(i))
                widget.bind("<Double-Button-1>", lambda e, i=idx: self._select_and_accept(i))

        for c in range(columns):
            self.grid_frame.grid_columnconfigure(c, weight=1)

    def _select(self, idx):
        if idx < 0 or idx >= len(self.entries):
            return
        self.selected_index = idx
        entry = self.entries[idx]
        img = entry.get("img")
        if img is not None:
            preview = img.copy()
            preview.thumbnail((350, 440), Image.LANCZOS)
            self.preview_ref = ImageTk.PhotoImage(preview)
            self.preview_label.configure(image=self.preview_ref, text="")
        source = self.source_getter(entry)
        title = entry.get("title") or "(no nearby text)"
        self.info_var.set(
            f"Page: {idx + 1}\n"
            f"Editor line: {entry.get('line')}\n"
            f"Source: {source.get('label', 'Image')}\n"
            f"{source.get('detail', '')}\n"
            f"Context: {title}"
        )

    def _select_and_accept(self, idx):
        self._select(idx)
        self.on_select()

    def on_select(self):
        if self.selected_index is None:
            messagebox.showinfo("Select Page", "Please click the exact page you want to re-upload.", parent=self)
            return
        self.result = self.entries[self.selected_index]
        self.destroy()

    def on_cancel(self):
        self.result = None
        self.destroy()


class ReuploadPDFPageSelector(tk.Toplevel):
    """Visual selector for one exact slide/page from a replacement PDF."""
    def __init__(self, parent, pdf_path):
        super().__init__(parent)
        self.parent = parent
        self.pdf_path = pdf_path
        self.result = None
        self.images = []
        self.refs = []
        self.selected = None
        self.title("Select Replacement PDF Slide")
        self.geometry("1050x700")
        self.configure(bg="#23242e")

        tk.Label(self, text=f"Select the exact PDF slide to replace the old page",
                 bg="#23242e", fg="white", font=("Arial", 12, "bold")).pack(anchor="w", padx=12, pady=(10, 2))
        tk.Label(self, text=os.path.basename(pdf_path), bg="#23242e", fg="#b8bcc8").pack(anchor="w", padx=12, pady=(0, 8))

        body = tk.Frame(self, bg="#23242e")
        body.pack(fill="both", expand=True, padx=12)
        left = tk.Frame(body, bg="#1d1e27", bd=1, relief="solid")
        left.pack(side="left", fill="both", expand=True, padx=(0, 8))
        canvas = tk.Canvas(left, bg="#1d1e27", highlightthickness=0)
        sb = tk.Scrollbar(left, orient="vertical", command=canvas.yview)
        canvas.configure(yscrollcommand=sb.set)
        sb.pack(side="right", fill="y")
        canvas.pack(side="left", fill="both", expand=True)
        self.grid = tk.Frame(canvas, bg="#1d1e27")
        win = canvas.create_window((0, 0), window=self.grid, anchor="nw")
        self.grid.bind("<Configure>", lambda e: canvas.configure(scrollregion=canvas.bbox("all")))
        canvas.bind("<Configure>", lambda e: canvas.itemconfigure(win, width=max(e.width - 4, 1)))

        right = tk.Frame(body, bg="#1d1e27", width=360)
        right.pack(side="right", fill="y")
        right.pack_propagate(False)
        tk.Label(right, text="Slide Preview", bg="#1d1e27", fg="white", font=("Arial", 11, "bold")).pack(pady=8)
        self.preview = tk.Label(right, bg="#111218", fg="#9ca3af", text="Select a slide")
        self.preview.pack(fill="both", expand=True, padx=10, pady=8)
        self.info = tk.StringVar(value="No slide selected")
        tk.Label(right, textvariable=self.info, bg="#1d1e27", fg="#d8dbe3", justify="left", anchor="w").pack(fill="x", padx=10, pady=8)

        btn = tk.Frame(self, bg="#23242e")
        btn.pack(fill="x", padx=12, pady=10)
        tk.Button(btn, text="Use This Slide", command=self.on_ok, bg="#006bce", fg="white", width=16).pack(side="left", padx=5)
        tk.Button(btn, text="Cancel", command=self.on_cancel, bg="#c0342c", fg="white", width=12).pack(side="right", padx=5)

        self._load_pdf()
        self.transient(parent)
        self.grab_set()

    def _load_pdf(self):
        try:
            import pdfplumber
            with pdfplumber.open(self.pdf_path) as pdf:
                for page_no, page in enumerate(pdf.pages, start=1):
                    img = page.to_image(resolution=90).original.convert("RGB")
                    self.images.append((page_no, img))
                    thumb = img.copy()
                    thumb.thumbnail((145, 145), Image.LANCZOS)
                    ref = ImageTk.PhotoImage(thumb)
                    self.refs.append(ref)
                    card = tk.Frame(self.grid, bg="#292b36", bd=1, relief="solid", cursor="hand2")
                    row, col = divmod(page_no - 1, 3)
                    card.grid(row=row, column=col, padx=8, pady=8, sticky="nsew")
                    lbl = tk.Label(card, image=ref, bg="#111218")
                    lbl.pack(padx=8, pady=8)
                    txt = tk.Label(card, text=f"PDF Slide {page_no}", bg="#292b36", fg="white", font=("Arial", 9, "bold"))
                    txt.pack(pady=(0, 8))
                    for w in (card, lbl, txt):
                        w.bind("<Button-1>", lambda e, n=page_no: self._select(n))
                        w.bind("<Double-Button-1>", lambda e, n=page_no: self._select_and_accept(n))
                for c in range(3):
                    self.grid.grid_columnconfigure(c, weight=1)
        except Exception as exc:
            messagebox.showerror("PDF Preview Error", f"Could not create PDF slide previews:\n{exc}", parent=self)

    def _select(self, page_no):
        self.selected = page_no
        img = next((im for n, im in self.images if n == page_no), None)
        if img is not None:
            preview = img.copy()
            preview.thumbnail((325, 430), Image.LANCZOS)
            self.preview_ref = ImageTk.PhotoImage(preview)
            self.preview.configure(image=self.preview_ref, text="")
        self.info.set(f"Selected PDF slide: {page_no}\nThis exact slide will replace the selected page.")

    def _select_and_accept(self, page_no):
        self._select(page_no)
        self.on_ok()

    def on_ok(self):
        if self.selected is None:
            messagebox.showinfo("Select Slide", "Please select the exact PDF slide first.", parent=self)
            return
        img = next((im for n, im in self.images if n == self.selected), None)
        if img is None:
            return
        self.result = (self.selected, img)
        self.destroy()

    def on_cancel(self):
        self.result = None
        self.destroy()


class ResizeImageWindow(tk.Toplevel):
    def __init__(self, parent, img_obj, callback=None, title="Resize Image", bulk_option=False, enable_reupload=False):
        super().__init__(parent)
        self.title(title)
        self.resizable(False, False)
        self.callback = callback
        self.bulk_option = bulk_option
        self.parent = parent
        self.enable_reupload = enable_reupload

        self.orig_img = img_obj.copy()
        self.img_width, self.img_height = self.orig_img.size
        self.resized_img = self.orig_img.copy()

        self.configure(bg="#22222A")
        self.geometry("760x620")

        self.canvas = tk.Canvas(self, width=640, height=380, bg="#efeef5", highlightthickness=0)
        self.canvas.pack(padx=20, pady=10)

        self.photo_img = ImageTk.PhotoImage(self.resized_img)
        self.img_id = self.canvas.create_image(320, 190, image=self.photo_img)
        self.canvas.image = self.photo_img

        sliders = tk.Frame(self, bg="#22222A")
        sliders.pack(fill="x", pady=(0, 6))

        max_w = max(self.img_width * 3, 100)
        max_h = max(self.img_height * 3, 100)

        self.w_scale = tk.Scale(sliders, from_=50, to=max_w, orient="horizontal", label="Width px", bg="#22222A", fg="white", highlightthickness=0, length=250)
        self.w_scale.set(self.img_width)
        self.w_scale.pack(side="left", padx=10)

        self.h_scale = tk.Scale(sliders, from_=50, to=max_h, orient="horizontal", label="Height px", bg="#22222A", fg="white", highlightthickness=0, length=250)
        self.h_scale.set(self.img_height)
        self.h_scale.pack(side="left", padx=10)

        fit_frame = tk.Frame(self, bg="#22222A")
        fit_frame.pack(pady=(0, 8))

        tk.Label(fit_frame, text="Quick Resize", bg="#22222A", fg="white").pack(side="left", padx=5)
        tk.Button(fit_frame, text="Fit A4 Width", bg="#148B90", fg="white", command=self.fit_a4_width).pack(side="left", padx=5)
        tk.Button(fit_frame, text="Fit A4 Height", bg="#148B90", fg="white", command=self.fit_a4_height).pack(side="left", padx=5)

        btn_frame = tk.Frame(self, bg="#22222A")
        btn_frame.pack(pady=10)

        tk.Button(btn_frame, text="Save", command=self.save_and_close, bg="#2573eb", fg="white", width=10).pack(side="left", padx=10)
        tk.Button(btn_frame, text="Cancel", command=self.destroy, bg="#ef4455", fg="white", width=10).pack(side="left", padx=10)

        if self.enable_reupload:
            tk.Button(btn_frame, text="Reupload page", command=self.reupload_page, bg="#f97316", fg="white", width=14).pack(side="left", padx=10)

        self.w_scale.bind("<ButtonRelease-1>", self.resize_image)
        self.h_scale.bind("<ButtonRelease-1>", self.resize_image)

    def fit_a4_width(self):
        target_w = 800
        ratio = target_w / self.img_width
        target_h = int(self.img_height * ratio)
        self.w_scale.set(target_w)
        self.h_scale.set(max(50, target_h))
        self.resize_image()

    def fit_a4_height(self):
        target_h = 700
        ratio = target_h / self.img_height
        target_w = int(self.img_width * ratio)
        self.h_scale.set(target_h)
        self.w_scale.set(max(50, target_w))
        self.resize_image()

    def resize_image(self, event=None):
        w = self.w_scale.get()
        h = self.h_scale.get()
        if w > 20 and h > 20:
            self.resized_img = self.orig_img.resize((w, h), Image.LANCZOS)
            self.photo_img = ImageTk.PhotoImage(self.resized_img)
            self.canvas.itemconfig(self.img_id, image=self.photo_img)
            self.canvas.image = self.photo_img

    def reupload_page(self):
        if hasattr(self.parent, "run_reupload_flow"):
            self.parent.run_reupload_flow()
        else:
            messagebox.showinfo("Info", "Reupload flow not available.")

    def save_and_close(self):
        if self.callback:
            if self.bulk_option:
                self.callback(self.w_scale.get(), self.h_scale.get())
            else:
                self.callback(self.resized_img)
        self.destroy()


