    def insert_table(self):
        """Insert a directly editable Excel/Word-style table at the cursor."""
        dlg = TableInsertDialog(self)
        self.wait_window(dlg)
        if not dlg.result:
            return
        rows, cols = dlg.result
        try:
            table_frame = EditableTableFrame(
                self.text, rows, cols,
                on_change=lambda: self.status_text.set(
                    f"Editing table: {rows} rows x {cols} columns"
                )
            )

            before = set(self.text.window_names())
            insert_at = self.text.index(tk.INSERT)
            self.text.window_create(insert_at, window=table_frame, align="center", padx=2, pady=4)
            # Put the insertion cursor on the next editor line so normal T&C
            # typing can continue below the table.
            self.text.insert(tk.INSERT, "\n")
            self.text.update_idletasks()
            after = set(self.text.window_names())
            new_names = list(after - before)
            if not new_names:
                table_frame.destroy()
                messagebox.showerror("Table Error", "Editable table could not be inserted into Terms & Conditions.")
                return

            window_name = new_names[0]
            self.table_records[window_name] = {
                "rows": rows,
                "cols": cols,
                "line": int(self.text.index(window_name).split('.')[0]),
                "widget": table_frame,
                "window_name": window_name,
            }
            self.status_text.set(
                f"Editable table inserted: {rows} rows x {cols} columns. Click any cell and type or paste data."
            )
            self.on_editor_change()
            # Give the first cell real keyboard focus immediately. The user can
            # now type directly into the inserted table without needing another
            # dialog. The Edit Table Data popup remains available for bulk paste.
            self.text.update_idletasks()
            try:
                table_frame.entries[0][0].focus_force()
                table_frame.entries[0][0].selection_range(0, tk.END)
            except Exception:
                pass
        except Exception as e:
            messagebox.showerror("Table Error", f"Could not insert editable table:\n{e}")


    def _table_records_by_line(self):
        """Resolve editable table windows to their current Text line numbers."""
        result = {}
        live_names = set(self.text.window_names())
        stale = []
        for window_name, rec in list(self.table_records.items()):
            if window_name not in live_names:
                stale.append(window_name)
                continue
            try:
                line = int(self.text.index(window_name).split('.')[0])
                rec["line"] = line
                result[line] = rec
            except Exception:
                stale.append(window_name)
        for name in stale:
            self.table_records.pop(name, None)
        return result


    def configure_header_footer_pages(self):
        """Choose final PDF page numbers where BOTH header and footer are hidden."""
        dlg = tk.Toplevel(self)
        dlg.title("Remove Header & Footer From Pages")
        dlg.configure(bg="#23242e")
        dlg.geometry("500x290")
        dlg.resizable(False, False)
        dlg.transient(self)
        dlg.grab_set()

        main = tk.Frame(dlg, bg="#23242e")
        main.pack(fill="both", expand=True, padx=18, pady=16)
        tk.Label(main, text="Header / Footer Page Control", bg="#23242e", fg="white", font=("Arial", 14, "bold")).pack(anchor="w")
        tk.Label(
            main,
            text="Enter final PDF page numbers where BOTH header and footer should be removed.\nExamples: 6,7  or  6-8  or  2,5-7",
            bg="#23242e", fg="#cbd5e1", justify="left", font=("Arial", 9)
        ).pack(anchor="w", pady=(8, 12))

        current = ",".join(str(x) for x in sorted(self.header_footer_removed_pages))
        entry = tk.Entry(main, font=("Arial", 12), bg="white", fg="black")
        entry.pack(fill="x", pady=5)
        entry.insert(0, current)
        entry.focus_set()

        info = tk.StringVar(value=f"Currently hidden on: {current or 'None'}")
        tk.Label(main, textvariable=info, bg="#23242e", fg="#93c5fd", font=("Arial", 9, "italic")).pack(anchor="w", pady=6)

        buttons = tk.Frame(main, bg="#23242e")
        buttons.pack(fill="x", pady=(10, 0))

        def parse_pages(value):
            pages = set()
            for chunk in value.split(","):
                chunk = chunk.strip()
                if not chunk:
                    continue
                if "-" in chunk:
                    a, b = chunk.split("-", 1)
                    a, b = int(a.strip()), int(b.strip())
                    if a <= 0 or b <= 0:
                        raise ValueError
                    lo, hi = sorted((a, b))
                    pages.update(range(lo, hi + 1))
                else:
                    n = int(chunk)
                    if n <= 0:
                        raise ValueError
                    pages.add(n)
            return pages

        def apply():
            value = entry.get().strip()
            if not value:
                self.header_footer_removed_pages = set()
                self.status_text.set("Header and footer restored on all pages.")
                dlg.destroy()
                return
            try:
                pages = parse_pages(value)
            except Exception:
                messagebox.showerror("Invalid Page Numbers", "Use examples like 6,7 or 6-8 or 2,5-7.", parent=dlg)
                return
            self.header_footer_removed_pages = pages
            self.status_text.set(
                "Header/footer removed from page(s): " + ", ".join(str(x) for x in sorted(pages))
            )
            dlg.destroy()

        tk.Button(buttons, text="Apply", command=apply, bg="#107d4e", fg="white", font=("Arial", 10, "bold"), width=12).pack(side="left")
        tk.Button(buttons, text="Clear All", command=lambda: (entry.delete(0, tk.END), info.set("Currently hidden on: None")), bg="#2563eb", fg="white", font=("Arial", 10, "bold"), width=12).pack(side="left", padx=8)
        tk.Button(buttons, text="Cancel", command=dlg.destroy, bg="#c0342c", fg="white", font=("Arial", 10, "bold"), width=12).pack(side="right")

