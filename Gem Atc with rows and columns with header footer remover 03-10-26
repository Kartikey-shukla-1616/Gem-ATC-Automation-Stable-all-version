    def extract_tc(self):
        filepath = filedialog.askopenfilename(title="Select GEM Tender PDF", filetypes=[("PDF Files", "*.pdf")])
        if not filepath:
            return
        self.status_text.set(f"Reading {os.path.basename(filepath)} ...")
        try:
            with pdfplumber.open(filepath) as pdf:
                startmarker = "Buyer Added Bid Specific Terms and Conditions"
                endmarker = "Disclaimer"
                capture = False
                headinginserted = False
                self.text.delete("1.0", tk.END)
                self.tc_source_file = self._source_file_key(filepath)
                self.tc_line_source = {}
                self.tc_source_ranges = {}
                self.pdf_slide_source = {}

                for pdf_page_number, page in enumerate(pdf.pages, start=1):
                    pagetext = page.extract_text() or ""
                    if not pagetext:
                        continue
                    lines = pagetext.splitlines()
                    chars = page.chars

                    linesbyy = {}
                    for ch in chars:
                        y = round(ch["top"], 1)
                        linesbyy.setdefault(y, []).append(ch)

                    boldlines = set()
                    for _, chlist in linesbyy.items():
                        boldcount = sum(1 for c in chlist if "Bold" in c.get("fontname", ""))
                        if boldcount and boldcount / len(chlist) >= 0.6:
                            texthere = "".join(c["text"] for c in chlist).strip()
                            if texthere:
                                boldlines.add(texthere)

                    page_tc_start = None
                    page_tc_had_content = False

                    for rawline in lines:
                        line = rawline.strip()
                        if startmarker in line:
                            capture = True
                            if not headinginserted:
                                self.text.insert(tk.END, "\n")
                                hstart = self.text.index("end-1c")
                                self.text.insert(tk.END, startmarker)
                                hend = self.text.index("end-1c")
                                self.text.tag_add("bold", hstart, hend)
                                if page_tc_start is None:
                                    page_tc_start = hstart
                                    page_tc_had_content = True
                                self.text.insert(tk.END, "\n")
                                headinginserted = True
                            continue

                        if capture and endmarker in line:
                            capture = False
                            break

                        if not capture:
                            continue
                        if is_probable_page_number(line):
                            continue
                        if not line:
                            continue
                        if is_garbage(line):
                            continue

                        isboldheading = False
                        for b in boldlines:
                            if line.startswith(b) or b.startswith(line):
                                isboldheading = True
                                break

                        if isboldheading:
                            self.text.insert(tk.END, "\n")
                            startidx = self.text.index("end-1c")
                            self.text.insert(tk.END, line)
                            endidx = self.text.index("end-1c")
                            self.text.tag_add("bold", startidx, endidx)
                            if page_tc_start is None:
                                page_tc_start = startidx
                            page_tc_had_content = True
                            self.text.insert(tk.END, "\n")
                        else:
                            startidx = self.text.index("end-1c")
                            self.text.insert(tk.END, line + "\n")
                            endidx = self.text.index("end-1c")
                            if page_tc_start is None:
                                page_tc_start = startidx
                            page_tc_had_content = True

                    if page_tc_had_content and page_tc_start is not None:
                        page_tc_end = self.text.index("end-1c")
                        self._mark_tc_text_range(page_tc_start, page_tc_end, self.tc_source_file, pdf_page_number)

            self.status_text.set("Terms & Conditions extracted.")
            messagebox.showinfo("Success", "Terms & Conditions extracted successfully.")
            self.on_editor_change()
        except Exception as e:
            messagebox.showerror("Error", f"Failed to read PDF:\n{e}")
            self.status_text.set("Error reading PDF.")

    def build_story_and_preview_source_map(self):
        styles = getSampleStyleSheet()

        def heading_style(sz):
            return ParagraphStyle(
                name=f"TCHeading{sz}",
                parent=styles["Heading2"],
                alignment=TA_CENTER,
                fontName=self.bold_font_name,
                fontSize=sz,
                spaceAfter=6,
                spaceBefore=12
            )

        def normal_style(sz):
            return ParagraphStyle(
                name=f"TCLine{sz}",
                parent=styles["Normal"],
                fontName=self.font_name,
                fontSize=sz,
                leading=sz + 3,
                spaceBefore=4,
                spaceAfter=2,
                alignment=TA_LEFT
            )

        frame_left = 40
        content_top_offset = 160
        footer_safe_height = 120
        frame_width = A4[0] - frame_left - 40
        frame_height = A4[1] - content_top_offset - self.page_margin_bottom - footer_safe_height

        elems = []
        preview_source_map = []

        total_lines = int(self.text.index("end-1c").split('.')[0])
        images_by_line = {}
        for line, pilimg, align in self.tracked_images:
            images_by_line.setdefault(line, []).append((pilimg, align))
        tables_by_line = self._table_records_by_line()

        usablew = frame_width * 0.95
        usableh = frame_height * 0.85
        current_page_line_count = 0
        max_lines_per_page = max(1, int(frame_height / self.line_height))
        page_started = False
        current_page_sources = []

        def ensure_page_started():
            nonlocal page_started
            if not page_started:
                page_started = True

        def finish_current_page():
            nonlocal page_started, current_page_sources
            if page_started:
                preview_source_map.append({"sources": list(current_page_sources)})
                current_page_sources = []
                page_started = False

        i = 1
        while i <= total_lines:
            linetext = self.text.get(f"{i}.0", f"{i}.0 lineend").strip()
            tags = self.text.tag_names(f"{i}.0")

            if i in tables_by_line:
                # Tables are rendered as real ReportLab tables in the final PDF.
                # Unlike ordinary pasted image slides, a table stays in the normal
                # text flow so it can sit naturally beside/after surrounding text.
                table_rec = tables_by_line[i]
                rows = int(table_rec.get("rows", 1))
                cols = int(table_rec.get("cols", 1))
                col_width = frame_width / max(cols, 1)
                raw_data = table_rec.get("widget").get_data() if table_rec.get("widget") is not None else []
                data = []
                cell_style = ParagraphStyle(
                    name=f"TableCell{line if False else i}",
                    parent=styles["Normal"], fontName=self.font_name, fontSize=9,
                    leading=11, textColor=colors.HexColor("#111827"),
                    alignment=TA_LEFT, spaceBefore=0, spaceAfter=0
                )
                for rr in range(rows):
                    row_data = []
                    for cc in range(cols):
                        value = ""
                        if rr < len(raw_data) and cc < len(raw_data[rr]):
                            value = str(raw_data[rr][cc])
                        # Paragraph handles wrapping inside the cell. Escape HTML-like
                        # characters so user-entered text is treated as plain text.
                        safe_value = (value.replace("&", "&amp;")
                                           .replace("<", "&lt;")
                                           .replace(">", "&gt;")
                                           .replace("\n", "<br/>"))
                        row_data.append(Paragraph(safe_value, cell_style))
                    data.append(row_data)
                rl_table = Table(data, colWidths=[col_width] * cols, hAlign="CENTER")
                rl_table.setStyle(TableStyle([
                    ("GRID", (0, 0), (-1, -1), 0.8, colors.HexColor("#4b5563")),
                    ("BACKGROUND", (0, 0), (-1, 0), colors.HexColor("#eef2f7")),
                    ("VALIGN", (0, 0), (-1, -1), "MIDDLE"),
                    ("LEFTPADDING", (0, 0), (-1, -1), 5),
                    ("RIGHTPADDING", (0, 0), (-1, -1), 5),
                    ("TOPPADDING", (0, 0), (-1, -1), 5),
                    ("BOTTOMPADDING", (0, 0), (-1, -1), 5),
                ]))
                ensure_page_started()
                table_source = {"type": "table", "line": i, "rows": rows, "cols": cols}
                current_page_sources.append(table_source)
                elems.append(Spacer(1, 8))
                elems.append(rl_table)
                elems.append(Spacer(1, 8))
                current_page_line_count += max(1, int(rows * 1.2))
                if current_page_line_count >= max_lines_per_page:
                    finish_current_page()
                    elems.append(PageBreak())
                    current_page_line_count = 0
                i += 1
                continue

            if i in images_by_line:
                if current_page_line_count > 0:
                    finish_current_page()
                    elems.append(PageBreak())
                    current_page_line_count = 0

                ensure_page_started()

                for pilimg, aligntag in images_by_line[i]:
                    imgpath, realw, realh = self._cache_image_once(pilimg)
                    ratio = min(usablew / realw, usableh / realh, 0.95)
                    imgw = realw * ratio
                    imgh = realh * ratio
                    rlimg = RLImage(imgpath, width=imgw, height=imgh)
                    rlimg.hAlign = aligntag.upper() if aligntag in ("left", "right", "center") else "CENTER"
                    rlimg._restrictSize(usablew, usableh)
                    elems.append(Spacer(1, 6))
                    elems.append(rlimg)
                    elems.append(Spacer(1, 6))
                    pdf_slide_id = None
                    for pdf_rec in self.pdf_images:
                        if pdf_rec[0] == "img" and len(pdf_rec) >= 7 and pdf_rec[3] is pilimg:
                            pdf_slide_id = pdf_rec[6]
                            break
                    source_info = {"type": "image", "line": i}
                    if pdf_slide_id is not None:
                        source_info["type"] = "pdf_slide"
                        source_info["pdf_slide_id"] = pdf_slide_id
                        slide_source = self.pdf_slide_source.get(pdf_slide_id)
                        if slide_source:
                            source_info["tc_source"] = [slide_source[0], slide_source[1]]
                    current_page_sources.append(source_info)
                    elems.append(_PreviewSourceMarker(source_info))

                finish_current_page()
                elems.append(PageBreak())
                current_page_line_count = 0
                i += 1
                continue

            if linetext:
                ensure_page_started()

                size = 12
                for tag in tags:
                    if tag.startswith("size"):
                        try:
                            size = int(tag.replace("size", ""))
                        except Exception:
                            pass

                if "heading" in tags:
                    style = heading_style(size)
                else:
                    style = normal_style(size)

                if "center" in tags:
                    style.alignment = TA_CENTER
                elif "right" in tags:
                    style.alignment = TA_RIGHT
                else:
                    style.alignment = TA_LEFT

                if "bold" in tags:
                    style.fontName = self.bold_font_name

                text_source = {"type": "text", "line": i}
                tc_sources = self._get_tc_sources_for_line(i)
                if tc_sources:
                    text_source["tc_sources"] = [[src[0], src[1]] for src in tc_sources]
                elems.append(_SourceParagraph(linetext, style, source=text_source))
                current_page_sources.append(text_source)
                current_page_line_count += 1

                if current_page_line_count >= max_lines_per_page:
                    finish_current_page()
                    elems.append(PageBreak())
                    current_page_line_count = 0

            i += 1

        finish_current_page()

        while elems and isinstance(elems[-1], PageBreak):
            elems.pop()
        while preview_source_map and not preview_source_map[-1]["sources"]:
            preview_source_map.pop()

        return elems, preview_source_map, frame_left, frame_width, frame_height

    def pdf_preview_render(self, outputfile="previewtemp.pdf", showmessage=True):
        elems, preview_source_map, frame_left, frame_width, frame_height = self.build_story_and_preview_source_map()
        self.preview_source_map = preview_source_map

        if not elems:
            open(outputfile, "wb").close()
            self.preview_source_map = []
            self.preview_total_pages = 0
            return

        frame_margin_bottom = self.page_margin_bottom + 120
        frame = Frame(frame_left, frame_margin_bottom, frame_width, frame_height, id="bodyframe")
        template = PageTemplate(id="gematc", frames=[frame], onPage=self.on_page)
        doc = _SourceTrackingDocTemplate(
            outputfile, pagesize=A4, pageTemplates=[template]
        )
        doc.build(elems)

        # The old estimate counted editor lines, not wrapped PDF paragraphs.
        # Use ReportLab's actual page numbers so Page 3 always maps to PDF Page 3.
        # Read the finished PDF for the authoritative page count. ReportLab's
        # internal ``doc.page`` can differ from the final PDF count in edge cases
        # involving page breaks, so it must not be the validation source for the UI.
        try:
            with pdfplumber.open(outputfile) as rendered_pdf:
                actual_page_count = len(rendered_pdf.pages)
        except Exception:
            actual_page_count = max(int(getattr(doc, "page", 0) or 0), 0)

        actual_source_map = []
        for page_no in range(1, actual_page_count + 1):
            actual_source_map.append({
                "sources": list(doc.page_sources.get(page_no, []))
            })
        self.preview_source_map = actual_source_map
        self.preview_total_pages = actual_page_count

        if showmessage:
            self.status_text.set(f"PDF exported {outputfile}")

    def on_page(self, canvas, doc):
        pdfwidth, pdfheight = A4

        # Page-specific header/footer removal. The page number here is the final
        # ReportLab page number, so the user's 6,7 selection maps exactly to PDF 6,7.
        if self._should_hide_header_footer(doc.page):
            return

        if self.header_img_resized is not None:
            imgwidth, imgheight = self.header_img_resized.size
            availablewidth = pdfwidth - 100
            scale = min(availablewidth / imgwidth, 1.0)
            scaledwidth = int(imgwidth * scale)
            scaledheight = int(imgheight * scale)
            xpos = (pdfwidth - scaledwidth) / 2
            ypos = pdfheight - scaledheight - 20
            canvas.drawImage(ImageReader(self.header_img_resized), xpos, ypos, width=scaledwidth, height=scaledheight, preserveAspectRatio=True)

        if self.footer_img_resized is not None:
            imgwidth, imgheight = self.footer_img_resized.size
            availablewidth = pdfwidth - 100
            scale = min(availablewidth / imgwidth, 1.0)
            scaledwidth = int(imgwidth * scale)
            scaledheight = int(imgheight * scale)
            xpos = 40
            ypos = self.page_margin_bottom
            canvas.drawImage(ImageReader(self.footer_img_resized), xpos, ypos, width=scaledwidth, height=scaledheight, preserveAspectRatio=True)

