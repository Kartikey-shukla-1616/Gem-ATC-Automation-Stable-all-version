    def _source_file_key(self, filepath):
        try:
            return os.path.normcase(os.path.abspath(filepath))
        except Exception:
            return filepath

    def _mark_tc_text_range(self, start_index, end_index, source_file, pdf_page_number):
        # Store the source page as a real Tk text tag.  Unlike editor line
        # numbers, tag ranges move with the actual characters when content is
        # inserted/deleted elsewhere in the Text widget.
        source_key = self._source_file_key(source_file)
        safe = abs(hash((source_key, pdf_page_number, datetime.now().timestamp())))
        tag = f"tcsource_{safe}"
        try:
            self.text.tag_add(tag, start_index, end_index)
            self.tc_source_ranges[(source_key, pdf_page_number)] = tag
            self.tc_line_source[pdf_page_number] = (source_key, tag)
        except Exception:
            pass

    def _get_tc_source_for_line(self, line):
        try:
            idx = self.text.index(f"{line}.0")
            for (source_key, page_no), tag in self.tc_source_ranges.items():
                ranges = self.text.tag_ranges(tag)
                for n in range(0, len(ranges), 2):
                    if self.text.compare(idx, ">=", ranges[n]) and self.text.compare(idx, "<", ranges[n + 1]):
                        return source_key, page_no
        except Exception:
            pass
        return None

    def _get_tc_sources_for_line(self, line):
        """Return every T&C source page whose tagged text contains this line."""
        found = []
        try:
            idx = self.text.index(f"{line}.0")
            for (source_key, page_no), tag in list(self.tc_source_ranges.items()):
                ranges = self.text.tag_ranges(tag)
                for n in range(0, len(ranges), 2):
                    if self.text.compare(idx, ">=", ranges[n]) and self.text.compare(idx, "<", ranges[n + 1]):
                        item = (source_key, page_no)
                        if item not in found:
                            found.append(item)
                        break
        except Exception:
            pass
        return found

    def _delete_tc_lines_for_source_page(self, source_file, pdf_page_number):
        if not source_file or pdf_page_number is None:
            return 0

        source_key = self._source_file_key(source_file)
        key = (source_key, pdf_page_number)
        tag = self.tc_source_ranges.get(key)
        deleted_chars = 0

        # Delete by the exact tagged characters, never by editor line numbers.
        # This remains correct after PDF pages/images/docs are inserted before
        # or after the original Terms & Conditions text.
        if tag:
            try:
                # Capture all ranges first, then delete from bottom to top.
                # Tk text indices automatically shift, so this removes the
                # exact characters belonging to this source page even when
                # other text/images were inserted later.
                ranges = list(self.text.tag_ranges(tag))
                for n in range(len(ranges) - 2, -1, -2):
                    start_idx = ranges[n]
                    end_idx = ranges[n + 1]
                    if self.text.compare(start_idx, "<", end_idx):
                        deleted_chars += len(self.text.get(start_idx, end_idx))
                        self.text.delete(start_idx, end_idx)
                try:
                    self.text.tag_delete(tag)
                except Exception:
                    pass
            except Exception:
                # Last-resort fallback: remove any current ranges one by one.
                try:
                    while True:
                        ranges = list(self.text.tag_ranges(tag))
                        if len(ranges) < 2:
                            break
                        start_idx, end_idx = ranges[-2], ranges[-1]
                        if not self.text.compare(start_idx, "<", end_idx):
                            break
                        deleted_chars += len(self.text.get(start_idx, end_idx))
                        self.text.delete(start_idx, end_idx)
                    try:
                        self.text.tag_delete(tag)
                    except Exception:
                        pass
                except Exception:
                    pass
            self.tc_source_ranges.pop(key, None)
            if self.tc_line_source.get(pdf_page_number, (None, None))[0] == source_key:
                self.tc_line_source.pop(pdf_page_number, None)
            return deleted_chars

        # Compatibility fallback for content created before the tagged-range
        # mapping existed.
        lines = []
        total_lines = int(self.text.index("end-1c").split('.')[0])
        for line in range(1, total_lines + 1):
            info = self._get_tc_source_for_line(line)
            if info and self._source_file_key(info[0]) == source_key and info[1] == pdf_page_number:
                lines.append(line)
        if lines:
            self._remove_lines_everywhere(lines)
        self.tc_line_source.pop(pdf_page_number, None)
        return len(lines)

    def _make_pdf_slide_id(self, pil_img):
        # Each extracted PDF page gets its own permanent object identity.
        # The preview page number is resolved to this identity before removal,
        # so editor line numbers are never used as the primary PDF-slide key.
        return f"pdfslide-{id(pil_img)}-{datetime.now().timestamp()}-{len(self.pdf_images) + 1}"

    def _find_pdf_slide_record_by_id(self, pdf_slide_id):
        if not pdf_slide_id:
            return None
        for rec in self.pdf_images:
            if len(rec) >= 7 and rec[6] == pdf_slide_id:
                return rec
        return None

    def _delete_pdf_slide_by_id(self, pdf_slide_id):
        # Preview page -> exact PDF slide record -> exact editor image ->
        # exact extracted T&C source page.  The important rule is that a
        # removed preview page must also remove its corresponding text from
        # the editor Text widget.
        rec = self._find_pdf_slide_record_by_id(pdf_slide_id)
        if rec is None:
            return False

        pil_img = rec[3]
        source_info = self.pdf_slide_source.get(pdf_slide_id)
        text_image_name = rec[7] if len(rec) >= 8 else None
        deleted = False

        # 1) Remove the exact embedded image object from the Text widget.
        if text_image_name:
            try:
                if text_image_name in self.text.image_names():
                    self.text.delete(text_image_name)
                    deleted = True
            except Exception:
                pass

        # Older records may not have the stored Tk image name. Keep a safe
        # object-identity fallback for those records only.
        if not deleted:
            for image_name in list(self.text.image_names()):
                try:
                    image_index = self.text.index(image_name)
                    for _, tracked_img, _ in self.tracked_images:
                        if tracked_img is pil_img:
                            self.text.delete(image_index)
                            deleted = True
                            break
                    if deleted:
                        break
                except Exception:
                    pass

        # 2) Remove the COMPLETE extracted T&C text belonging to this source
        # PDF page. The tag range follows the characters even when other
        # pages/images/docs were inserted before or after the text.
        tc_deleted = 0
        if source_info:
            tc_deleted = self._delete_tc_lines_for_source_page(
                source_info[0], source_info[1]
            )
        else:
            # If an old slide record has no source-file mapping, use its page
            # number when that page number identifies exactly one extracted
            # T&C source. This is deliberately conservative so unrelated T&C
            # pages are never deleted.
            inferred_page = None
            try:
                parts = str(pdf_slide_id).split("-")
                for token in reversed(parts):
                    if token.isdigit():
                        inferred_page = int(token)
                        break
            except Exception:
                inferred_page = None

            if inferred_page is not None:
                # First prefer the currently extracted tender PDF. This
                # handles older slide records that were created before the
                # explicit pdf_slide_source mapping was introduced.
                current_tc_source = getattr(self, "tc_source_file", None)
                if current_tc_source and (current_tc_source, inferred_page) in self.tc_source_ranges:
                    tc_deleted = self._delete_tc_lines_for_source_page(
                        current_tc_source, inferred_page
                    )
                else:
                    matches = [
                        (key, tag) for key, tag in self.tc_source_ranges.items()
                        if key[1] == inferred_page
                    ]
                    if len(matches) == 1:
                        (src_key, page_no), _ = matches[0]
                        tc_deleted = self._delete_tc_lines_for_source_page(
                            src_key, page_no
                        )

        # 3) Remove every internal record for the same exact image/slide.
        self.pdf_images = [
            r for r in self.pdf_images
            if not (len(r) >= 7 and r[6] == pdf_slide_id)
        ]
        self.pdf_slide_source.pop(pdf_slide_id, None)
        self.docs_images = [
            r for r in self.docs_images
            if len(r) < 4 or r[3] is not pil_img
        ]
        self.tracked_images = [r for r in self.tracked_images if r[1] is not pil_img]
        self.image_archive = [e for e in self.image_archive if e.get("img") is not pil_img]

        return deleted or tc_deleted > 0

    def insert_image_inline(self, pil_img, align="center", ispdf=False, isdocs=False, pdf_slide_id=None):
        insert_index = self.text.index("insert")
        curline = int(insert_index.split('.')[0])
        line_text = self.text.get(f"{curline}.0", f"{curline}.0 lineend")

        if line_text.strip():
            self.text.insert(f"{curline + 1}.0", "\n\n")
            insert_index = f"{curline + 1}.0"

        self.text.insert(insert_index, "")
        insert_index = self.text.index("insert")
        img_tk = ImageTk.PhotoImage(pil_img)
        self.tk_images.append(img_tk)
        before_image_names = set(self.text.image_names())
        self.text.image_create(insert_index, image=img_tk)
        after_image_names = set(self.text.image_names())
        new_image_names = list(after_image_names - before_image_names)
        text_image_name = new_image_names[0] if new_image_names else None
        self.text.insert(self.text.index(f"{insert_index} lineend"), "\n\n")
        lineno = int(self.text.index(insert_index).split('.')[0])

        rec = (lineno, pil_img, align)
        self.tracked_images = [r for r in self.tracked_images if r[0] != lineno]
        self.tracked_images.append(rec)
        self.add_to_archive(lineno, pil_img)

        if ispdf:
            if pdf_slide_id is None:
                pdf_slide_id = self._make_pdf_slide_id(pil_img)
            self.pdf_images = [r for r in self.pdf_images if r[2] != lineno]
            self.pdf_images.append(["img", None, lineno, pil_img, None, align, pdf_slide_id, text_image_name])
            if pdf_slide_id is not None and hasattr(self, "_pending_pdf_source") and self._pending_pdf_source:
                self.pdf_slide_source[pdf_slide_id] = self._pending_pdf_source

        if isdocs:
            self.docs_images = [r for r in self.docs_images if r[2] != lineno]
            self.docs_images.append(["img", None, lineno, pil_img, None, align, text_image_name])

        self.on_editor_change()
        return lineno

    def insert_image_on_newline(self, pil_img, align="center", aroundline=None, ispdf=False, isdocs=False, pdf_slide_id=None):
        if aroundline is None:
            return self.insert_image_inline(pil_img, align, ispdf=ispdf, isdocs=isdocs, pdf_slide_id=pdf_slide_id)

        insertline = aroundline + 1
        self.text.insert(f"{insertline}.0", "\n\n")
        insertline = int(self.text.index(f"{insertline}.0").split('.')[0])

        img_tk = ImageTk.PhotoImage(pil_img)
        self.tk_images.append(img_tk)
        before_image_names = set(self.text.image_names())
        self.text.image_create(f"{insertline}.0", image=img_tk)
        after_image_names = set(self.text.image_names())
        new_image_names = list(after_image_names - before_image_names)
        text_image_name = new_image_names[0] if new_image_names else None
        self.text.insert(f"{insertline}.0 lineend", "\n\n")

        rec = (insertline, pil_img, align)
        self.tracked_images = [r for r in self.tracked_images if r[0] != insertline]
        self.tracked_images.append(rec)
        self.add_to_archive(insertline, pil_img)

        if ispdf:
            if pdf_slide_id is None:
                pdf_slide_id = self._make_pdf_slide_id(pil_img)
            self.pdf_images = [r for r in self.pdf_images if r[2] != insertline]
            self.pdf_images.append(["img", None, insertline, pil_img, None, align, pdf_slide_id, text_image_name])
            if pdf_slide_id is not None and hasattr(self, "_pending_pdf_source") and self._pending_pdf_source:
                self.pdf_slide_source[pdf_slide_id] = self._pending_pdf_source

        if isdocs:
            self.docs_images = [r for r in self.docs_images if r[2] != insertline]
            self.docs_images.append(["img", None, insertline, pil_img, None, align, text_image_name])

        self.on_editor_change()
        return insertline

