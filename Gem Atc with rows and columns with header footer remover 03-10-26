    def _parse_page_input(self, textvalue, maxpage):
        pages = set()
        textvalue = textvalue.strip()
        if not textvalue:
            return pages

        for chunk in textvalue.split(","):
            chunk = chunk.strip()
            if not chunk:
                continue
            if "-" in chunk:
                parts = chunk.split("-")
                if len(parts) != 2:
                    continue
                try:
                    start = int(parts[0].strip())
                    end = int(parts[1].strip())
                    if start > end:
                        start, end = end, start
                    for p in range(start, end + 1):
                        if 1 <= p <= maxpage:
                            pages.add(p)
                except Exception:
                    pass
            else:
                try:
                    p = int(chunk)
                    if 1 <= p <= maxpage:
                        pages.add(p)
                except Exception:
                    pass

        return pages

    def _remove_line_text_content(self, line):
        try:
            line_start = f"{line}.0"
            line_end = f"{line}.0 lineend"
            existing = self.text.get(line_start, line_end)
            if existing is not None and existing != "":
                self.text.delete(line_start, line_end)
        except Exception:
            pass

    def _image_name_at_line(self, line):
        """Return the Tk Text image name currently stored on a line."""
        try:
            for image_name in self.text.image_names():
                idx = self.text.index(image_name)
                if int(idx.split(".")[0]) == int(line):
                    return image_name
        except Exception:
            pass
        return None

    def _sync_image_records_after_text_change(self, image_snapshot=None):
        """Rebuild image line numbers after Text widget lines have shifted.

        Tkinter Text line numbers are NOT stable after a deletion.  The old
        implementation kept stale line numbers, which caused Preview to be
        rebuilt from the wrong image records.  Image names, however, remain
        attached to the actual embedded image, so they are used as stable
        identities here.
        """
        image_snapshot = image_snapshot or {}

        current_names = set(self.text.image_names())
        new_tracked = []
        new_pdf = []
        new_docs = []
        new_archive = []

        # Build a name -> current line map from the actual Text widget.
        name_to_line = {}
        for name in current_names:
            try:
                name_to_line[name] = int(self.text.index(name).split(".")[0])
            except Exception:
                pass

        # Rebuild tracked_images using the stable Tk image name snapshot.
        for name, meta in image_snapshot.items():
            if name not in name_to_line:
                continue
            line = name_to_line[name]
            pil_img = meta.get("img")
            align = meta.get("align", "center")
            if pil_img is not None:
                new_tracked.append((line, pil_img, align))

        # Rebuild PDF image records.  Preserve every field but replace the
        # stale editor line number with the current line number.
        for rec in self.pdf_images:
            if not rec:
                continue
            name = rec[7] if len(rec) >= 8 else None
            if name and name in name_to_line:
                nr = list(rec)
                nr[2] = name_to_line[name]
                new_pdf.append(nr)
            else:
                # Legacy record: use the image object identity as fallback.
                pil_img = rec[3] if len(rec) >= 4 else None
                found_name = None
                for snap_name, meta in image_snapshot.items():
                    if meta.get("img") is pil_img and snap_name in name_to_line:
                        found_name = snap_name
                        break
                if found_name is not None:
                    nr = list(rec)
                    nr[2] = name_to_line[found_name]
                    if len(nr) < 8:
                        nr.append(found_name)
                    else:
                        nr[7] = found_name
                    new_pdf.append(nr)

        # Rebuild Add Docs records in the same way.
        for rec in self.docs_images:
            if not rec:
                continue
            name = rec[6] if len(rec) >= 7 else None
            if name and name in name_to_line:
                nr = list(rec)
                nr[2] = name_to_line[name]
                new_docs.append(nr)
            else:
                pil_img = rec[3] if len(rec) >= 4 else None
                found_name = None
                for snap_name, meta in image_snapshot.items():
                    if meta.get("img") is pil_img and snap_name in name_to_line:
                        found_name = snap_name
                        break
                if found_name is not None:
                    nr = list(rec)
                    nr[2] = name_to_line[found_name]
                    if len(nr) < 7:
                        nr.append(found_name)
                    else:
                        nr[6] = found_name
                    new_docs.append(nr)

        self.tracked_images = new_tracked
        self.pdf_images = new_pdf
        self.docs_images = new_docs

        # Rebuild the archive from the surviving actual images.
        for name, meta in image_snapshot.items():
            if name not in name_to_line:
                continue
            img = meta.get("img")
            if img is None:
                continue
            line = name_to_line[name]
            new_archive.append({
                "id": id(img),
                "line": line,
                "img": img,
                "width": img.size[0],
                "height": img.size[1],
                "title": self.title_for_line(line)
            })
        self.image_archive = new_archive

    def _remove_lines_everywhere(self, lines_to_delete):
        """Remove ONLY the requested editor lines and their embedded images.

        This function deliberately does not remove an entire T&C source page.
        Preview removal is page-local: whatever text/images are represented by
        the selected preview page are removed, and unrelated content stays.
        """
        if not lines_to_delete:
            return

        lines_to_delete = set(int(x) for x in lines_to_delete)

        # Snapshot stable Tk image names BEFORE deleting anything because line
        # numbers will shift as soon as the first line is removed.
        image_snapshot = {}
        for image_name in list(self.text.image_names()):
            try:
                line = int(self.text.index(image_name).split(".")[0])
                pil_img = None
                align = "center"
                for rec in self.pdf_images:
                    if len(rec) >= 8 and rec[7] == image_name:
                        pil_img = rec[3]
                        align = rec[5] if len(rec) > 5 else "center"
                        break
                if pil_img is None:
                    for rec in self.docs_images:
                        if len(rec) >= 7 and rec[6] == image_name:
                            pil_img = rec[3]
                            align = rec[5] if len(rec) > 5 else "center"
                            break
                if pil_img is None:
                    for line_no, img, a in self.tracked_images:
                        if line_no == line:
                            pil_img = img
                            align = a
                            break
                image_snapshot[image_name] = {
                    "line": line,
                    "img": pil_img,
                    "align": align
                }
            except Exception:
                pass

        # Delete bottom-to-top.  Delete the complete text line as well as the
        # embedded image on that line.  Tags (including T&C source tags) move
        # automatically with the surviving text.
        for line in sorted(lines_to_delete, reverse=True):
            try:
                self._delete_editor_line_image_only(line)
                start_idx = f"{line}.0"
                end_idx = f"{line + 1}.0"
                last_line = int(self.text.index("end-1c").split(".")[0])
                if line < last_line:
                    self.text.delete(start_idx, end_idx)
                else:
                    self.text.delete(start_idx, "end-1c")
            except Exception:
                try:
                    self._remove_line_text_content(line)
                except Exception:
                    pass

        self._sync_image_records_after_text_change(image_snapshot)
        # Remove table metadata whose embedded window was deleted.
        self._table_records_by_line()

    def remove_pages_from_preview_input(self):
        # Synchronize against the PDF currently shown in the preview BEFORE
        # validating input. The old implementation trusted an approximate source
        # map and could reject the last visible page (e.g. page 3 of 3).
        actual_pages = None
        if self.preview_pdf_path and os.path.exists(self.preview_pdf_path):
            try:
                with pdfplumber.open(self.preview_pdf_path) as rendered_pdf:
                    actual_pages = len(rendered_pdf.pages)
                if (actual_pages != self.preview_total_pages or
                        actual_pages != len(self.preview_source_map)):
                    self.pdf_preview_render(self.preview_pdf_path, showmessage=False)
                    # The source editor may have changed since the previous preview;
                    # use the newly rendered PDF's page count and source map.
                    actual_pages = self.preview_total_pages
            except Exception as exc:
                self.status_text.set(f"Preview page count could not be checked: {exc}")

        if actual_pages is None:
            actual_pages = max(
                int(self.preview_total_pages or 0),
                len(self.preview_source_map or [])
            )

        if actual_pages <= 0:
            messagebox.showinfo("Info", "Pehle Preview PDF generate karein.")
            return

        # Never let a short source map make a visible PDF page appear invalid.
        if len(self.preview_source_map) < actual_pages:
            self.preview_source_map.extend(
                {"sources": []}
                for _ in range(actual_pages - len(self.preview_source_map))
            )
        self.preview_total_pages = actual_pages

        txt = self.remove_page_entry.get().strip()
        if not txt:
            messagebox.showinfo(
                "Info",
                "Page number dalo. Example: 3 or 3,5,7 or 3-5."
            )
            return

        pages_to_remove = self._parse_page_input(txt, actual_pages)
        if not pages_to_remove:
            messagebox.showerror(
                "Invalid Page Number",
                f"Valid preview page number/range dalo (1-{actual_pages}). "
                "Example: 3 or 3,5-7."
            )
            return

        self._remove_pages_by_preview_numbers(sorted(pages_to_remove))

    def _remove_pages_by_preview_numbers(self, page_numbers):
        """Permanently remove selected generated-preview pages.

        The current preview_source_map is the bridge:
            preview page -> editor line/image -> PDF slide/source.

        We snapshot the selected sources before changing the Text widget because
        Tkinter line numbers shift immediately after deletion.  We then delete
        bottom-to-top and rebuild the preview from the surviving editor content.
        """
        requested_pages = sorted(set(int(p) for p in page_numbers if int(p) > 0))
        if not requested_pages:
            messagebox.showinfo("Info", "Valid preview page nahi mila.")
            return

        # The visible PDF page count is authoritative. If an old/stale map is
        # shorter, refresh it from the currently displayed preview before deciding
        # a page is invalid.
        if self.preview_pdf_path and os.path.exists(self.preview_pdf_path):
            try:
                with pdfplumber.open(self.preview_pdf_path) as rendered_pdf:
                    pdf_page_count = len(rendered_pdf.pages)
                if (len(self.preview_source_map) != pdf_page_count or
                        self.preview_total_pages != pdf_page_count):
                    self.pdf_preview_render(self.preview_pdf_path, showmessage=False)
                    pdf_page_count = self.preview_total_pages
            except Exception:
                pdf_page_count = max(len(self.preview_source_map), self.preview_total_pages)
        else:
            pdf_page_count = max(len(self.preview_source_map), self.preview_total_pages)

        if len(self.preview_source_map) < pdf_page_count:
            self.preview_source_map.extend(
                {"sources": []}
                for _ in range(pdf_page_count - len(self.preview_source_map))
            )

        valid_pages = [
            p for p in requested_pages
            if 1 <= p <= pdf_page_count
        ]
        invalid_pages = [p for p in requested_pages if p not in valid_pages]

        if invalid_pages:
            self.status_text.set(
                "Invalid preview pages ignored: " +
                ", ".join(str(p) for p in invalid_pages)
            )

        if not valid_pages:
            messagebox.showinfo("Info", "Valid preview page nahi mila.")
            return

        selected_sources = []
        lines_to_delete = set()

        # Snapshot the exact sources represented by the selected preview pages.
        for page_no in valid_pages:
            pageinfo = self.preview_source_map[page_no - 1]
            for src in pageinfo.get("sources", []):
                selected_sources.append(dict(src))
                line = src.get("line")
                if line is not None:
                    try:
                        lines_to_delete.add(int(line))
                    except (TypeError, ValueError):
                        pass

        # Deduplicate source records for the removal audit.
        deduped_sources = []
        seen_source_keys = set()
        for src in selected_sources:
            key = (
                src.get("type"),
                src.get("line"),
                src.get("pdf_slide_id"),
                tuple(src.get("tc_source", [])) if src.get("tc_source") else None,
            )
            if key not in seen_source_keys:
                seen_source_keys.add(key)
                deduped_sources.append(src)

        if not lines_to_delete:
            messagebox.showinfo(
                "Info",
                "Selected preview page me removable text/image/PDF content nahi mila."
            )
            return

        # One operation removes both normal T&C text and embedded PDF slides.
        self._remove_lines_everywhere(lines_to_delete)

        try:
            # Rebuild from the now-authoritative Text widget. Deleted content
            # therefore cannot come back when Preview PDF is generated again.
            self.preview_generation_id += 1
            _, refreshed_source_map, _, _, _ = (
                self.build_story_and_preview_source_map()
            )
            self.preview_source_map = refreshed_source_map
            self.preview_total_pages = len(refreshed_source_map)

            # The selected pages are physically gone; nothing remains to hide.
            self.preview_removed_indices = set()

            if self.preview_pdf_path:
                self.pdf_preview_render(
                    self.preview_pdf_path,
                    showmessage=False
                )

            # Keep a permanent UI/audit record of the pages the user removed.
            self._record_removed_preview_pages(
                valid_pages,
                source_count=len(deduped_sources),
                line_count=len(lines_to_delete),
            )

            self._setup_preview_canvas(
                self.preview_total_pages,
                self.preview_generation_id
            )

        except Exception as e:
            self.status_text.set("Page removed, but preview refresh failed.")
            messagebox.showwarning(
                "Preview Refresh",
                f"Page remove ho gaya, lekin preview refresh nahi ho paya:\n{e}"
            )
            self.on_editor_change()
            return

        self.remove_page_entry.delete(0, tk.END)
        removed_text = ", ".join(str(x) for x in valid_pages)
        self.status_text.set(
            f"Preview page(s) {removed_text} permanently removed from "
            "Text Area, PDF slides and Preview."
        )
        self.on_editor_change()

    def reset_removed_pages(self):
        """Clear the removal-history display without restoring deleted content."""
        self.remove_page_entry.delete(0, tk.END)
        self.preview_removed_indices = set()
        self.preview_removed_pages = []
        self.preview_removal_log = []
        self._update_removed_pages_label()

        if self.preview_total_pages and self.preview_source_map:
            self._setup_preview_canvas(
                self.preview_total_pages,
                self.preview_generation_id
            )

        self.status_text.set(
            "Removal history cleared. Deleted content remains permanently removed."
        )

    def compress_and_save_pdf(self):
        tmppdf = os.path.join(self.temp_dir, "compressbase.pdf")
        try:
            self.pdf_preview_render(tmppdf, showmessage=False)
        except Exception as e:
            messagebox.showerror("Error", f"Failed to generate base PDF:\n{e}")
            return

        if not os.path.exists(tmppdf) or os.path.getsize(tmppdf) == 0:
            messagebox.showinfo("Info", "No content to compress.")
            return

        savepath = filedialog.asksaveasfilename(defaultextension=".pdf", filetypes=[("PDF Files", "*.pdf")], title="Save Compressed PDF")
        if not savepath:
            return

        targetval = self.target_size_mb.get()
        unit = self.target_size_unit.get()
        if targetval <= 0:
            messagebox.showerror("Error", "Target size must be > 0.")
            return

        targetbytes = int(targetval * 1024 * 1024) if unit == "MB" else int(targetval * 1024)

        self.progress.config(mode="determinate")
        self.progress_var.set(0)
        self.wait_label.config(text="Compressing PDF, please wait...")
        self.status_text.set("Trying to compress PDF near selected size...")
        t = Thread(target=self._compress_worker, args=(tmppdf, savepath, targetbytes), daemon=True)
        t.start()

    def _compress_worker(self, srcpdf, dstpdf, targetbytes):
        try:
            from reportlab.pdfgen import canvas as rlcanvas
            kwargs = {}
            if POPPLER_PATH:
                kwargs["poppler_path"] = POPPLER_PATH
            pages = convert_from_path(srcpdf, dpi=150, **kwargs)
            totalpages = len(pages) or 1
            qualities = [95, 85, 75, 60, 50, 40, 30]
            bestpath = None
            bestsize = None

            for qidx, q in enumerate(qualities, start=1):
                tmpout = os.path.join(self.temp_dir, f"compress_q{q}.pdf")
                c = rlcanvas.Canvas(tmpout, pagesize=A4)
                pw, ph = A4

                for pidx, img in enumerate(pages, start=1):
                    bufname = os.path.join(self.temp_dir, f"page_{q}_{pidx}.jpg")
                    img.save(bufname, format="JPEG", quality=q)
                    pageimg = Image.open(bufname)
                    iw, ih = pageimg.size
                    scale = min(pw / iw, ph / ih)
                    nw, nh = iw * scale, ih * scale
                    x = (pw - nw) / 2
                    y = (ph - nh) / 2
                    c.drawImage(ImageReader(pageimg), x, y, width=nw, height=nh)
                    c.showPage()
                    try:
                        os.remove(bufname)
                    except Exception:
                        pass

                    progress = ((qidx - 1) * totalpages + pidx) / (totalpages * len(qualities)) * 100.0
                    self.after(0, self.progress_var.set, progress)

                c.save()
                sz = os.path.getsize(tmpout)

                if sz <= targetbytes:
                    bestpath = tmpout
                    bestsize = sz
                    break

                if bestpath is None or sz < bestsize:
                    bestpath = tmpout
                    bestsize = sz

            if bestpath:
                shutil.copy(bestpath, dstpdf)

            def done():
                if bestpath and os.path.exists(dstpdf):
                    finalkb = os.path.getsize(dstpdf) / 1024
                    self.status_text.set(f"Compressed PDF saved. Size {finalkb:.1f} KB.")
                    messagebox.showinfo("Done", f"Compressed PDF saved.\nsize {finalkb:.1f} KB")
                else:
                    self.status_text.set("Compression failed.")
                    messagebox.showerror("Error", "Could not compress PDF.")
                self.progress_var.set(0)
                self.wait_label.config(text="")

            self.after(0, done)
        except Exception as e:
            def showerr():
                self.progress_var.set(0)
                self.wait_label.config(text="")
                self.status_text.set("Error during compression.")
                messagebox.showerror("Error", f"Compression failed:\n{e}")
            self.after(0, showerr)

    def export_to_pdf(self):
        outputpath = filedialog.asksaveasfilename(defaultextension=".pdf", filetypes=[("PDF Files", "*.pdf")], title="Save ATC as PDF")
        if not outputpath:
            return
        if self.export_thread and self.export_thread.is_alive():
            messagebox.showinfo("Export", "Export already running, please wait.")
            return
        self.progress.config(mode="determinate")
        self.progress_var.set(0)
        self.wait_label.config(text="Exporting PDF, please wait...")
        self.status_text.set(f"Exporting to {outputpath} ...")
        self.export_thread = Thread(target=self._export_worker, args=(outputpath,), daemon=True)
        self.export_thread.start()

    def _export_worker(self, outputfile):
        try:
            elems, _, frame_left, frame_width, frame_height = self.build_story_and_preview_source_map()
            if not elems:
                open(outputfile, "wb").close()
            else:
                frame_margin_bottom = self.page_margin_bottom + 120
                frame = Frame(frame_left, frame_margin_bottom, frame_width, frame_height, id="bodyframe")
                template = PageTemplate(id="gematc", frames=[frame], onPage=self.on_page)
                doc = BaseDocTemplate(outputfile, pagesize=A4, pageTemplates=[template])
                doc.build(elems)

            def done():
                self.progress_var.set(100)
                self.wait_label.config(text="")
                self.status_text.set(f"PDF exported {outputfile}")
                messagebox.showinfo("Success", "PDF has been exported successfully.")

            self.after(0, done)
        except Exception as e:
            def showerr():
                self.status_text.set("Error exporting PDF.")
                messagebox.showerror("Export Error", f"PDF export failed:\n{e}")
                self.progress_var.set(0)
                self.wait_label.config(text="")
            self.after(0, showerr)


